# Server configuration
PORT=3000
NODE_ENV=production
SESSION_SECRET=change-me-to-a-secure-random-32-char-string-in-production

# Allow demo accounts login with 1-click on public preview (disabled in real production)
ALLOW_DEMO=true

# Centre & Locale defaults
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_CURRENCY=INR
DEFAULT_LOCALE=en-IN

# Optional AI Providers (System operates with built-in rule heuristics if unconfigured)
# Cloudflare Workers AI / Groq / Gemini
GROQ_API_KEY=
GEMINI_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional Email Service (In-app notifications work unconditionally)
RESEND_API_KEY=
FROM_EMAIL=notifications@coachingos.app

# Cloudflare D1 / R2 (when deployed to Cloudflare Workers)
D1_DATABASE_ID=
R2_BUCKET_NAME=
